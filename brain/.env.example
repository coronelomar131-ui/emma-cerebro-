# Copiá este archivo como .env (sin el .example) y poné la clave que vayas a usar.
# El .env no se sube a git: está en .gitignore.

# Gratis, sin tarjeta: se saca en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# De pago por uso: se saca en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Con --provider ollama no hace falta ninguna clave.
